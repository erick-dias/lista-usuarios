{
  "name": "lista-usuarios",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "nx serve",
    "mock-api": "json-server db.json --port 3000",
    "dev": "concurrently \"npm run mock-api\" \"npm run start\"",
    "build": "nx build",
    "watch": "nx build --watch --configuration development",
